# Copy to .env for local overrides (optional; .env is gitignored)
# ASP.NET Core reads these env vars automatically:
ConnectionStrings__DefaultConnection=Host=YOUR_DB_HOST;Port=5432;Database=postgres;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Connection Idle Lifetime=300

# Admin API key — required for all /api/admin routes (X-Admin-Key header).
# TODO: replace with Firebase admin claims once Firebase Auth is reinstated.
AdminApiKey=YOUR_ADMIN_API_KEY_HERE

# JWT signing key for matchmaking / me endpoints (min 32 characters). Never commit real values.
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=ShowUp
Jwt__Audience=ShowUpApp

# Cursor API key — server-side only for AI event search. Leave blank in source control; paste locally.
# Create at https://cursor.com/dashboard/api (key format crsr_...)
CURSOR_API_KEY=

# Google Maps Geocoding — server-side only for AI place resolution. Leave blank in source control; paste locally.
GOOGLE_MAPS_API_KEY=

# --- Email / OTP (Brevo SMTP, free tier: 300 emails/day) ---
# Get these from Brevo → SMTP & API → SMTP tab → "Generate a new SMTP key".
# Leave SmtpUser/SmtpPassword blank to run without an account: the app falls back to
# printing the verification code to the console instead of emailing it.
Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=587
Email__SmtpUser=YOUR_BREVO_LOGIN_EMAIL
Email__SmtpPassword=YOUR_BREVO_SMTP_KEY
# Must be an address verified under Brevo → Senders.
Email__FromAddress=YOUR_VERIFIED_SENDER_EMAIL
Email__FromName=ShowUp
